{
  "name": "@aag/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulated Alexa+ experience: an Echo-Show-style web UI whose assistant is a local LLM acting as an MCP client of @aag/mcp-server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c cyan,magenta \"tsx watch bridge/index.ts\" \"vite\"",
    "bridge": "tsx bridge/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
